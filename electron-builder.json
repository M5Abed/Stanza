{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.mohamedabed.stanza",
  "productName": "Stanza",
  "buildVersion": "${version}",
  "asar": true,
  "asarUnpack": [
    "node_modules/.prisma/**/*",
    "node_modules/@prisma/client/**/*"
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "M5Abed",
      "repo": "Stanza"
    }
  ],
  "forceCodeSigning": false,
  "directories": {
    "output": "release/v${version}"
  },
  "files": [
    "dist-electron",
    "dist",
    ".env",
    "package.json",
    "!node_modules/.prisma",
    "!node_modules/@prisma/client"
  ],
  "extraResources": [
    {
      "from": "node_modules/.prisma",
      "to": "node_modules/.prisma"
    },
    {
      "from": "node_modules/@prisma/client",
      "to": "node_modules/@prisma/client"
    }
  ],
  "mac": {
    "artifactName": "${productName}_${version}_mac.${ext}",
    "target": [
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "build/icon.png",
    "extraResources": [
      {
        "from": "resources/yt-dlp_macos",
        "to": "yt-dlp_macos"
      }
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "${productName}_${version}.${ext}",
    "extraResources": [
      {
        "from": "resources/yt-dlp.exe",
        "to": "yt-dlp.exe"
      }
    ],
    "sign": null,
    "signDlls": false
  },
  "linux": {
    "target": ["AppImage"],
    "category": "AudioVideo",
    "icon": "build/icon.png",
    "artifactName": "${productName}_${version}_linux.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "compression": "maximum"
}
