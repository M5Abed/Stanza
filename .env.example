# Local dev — copy to `.env` (never commit `.env`).

DATABASE_URL="file:./dev.db"

# Spotify Dashboard → app → Client ID / Client Secret (Client Credentials = metadata only).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius API → api-clients page → Client ID / Client Secret (lyrics scraping).
GENIUS_CLIENT_ID=
GENIUS_CLIENT_SECRET=

# Google Gemini → AI Studio → API Key (Song Story feature, optional).
GEMINI_API_KEY=

# Last.fm → API account → API Key (radio recommendations, optional).
LASTFM_API_KEY=
